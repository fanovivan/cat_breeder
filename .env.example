# Скопируйте в .env и подставьте свои значения (файл .env в репозиторий не коммитить).
# SECRET_KEY должен быть длиннее 32 символов.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=False
USE_SQLITE=False
DB_NAME=cat_breeder
DB_USER=breeder
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Docker / продакшен:
REDIS_URL=redis://redis:6379/1
ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru
CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# Для локальной разработки без PostgreSQL можно включить:
# USE_SQLITE=True
# DB_HOST=localhost
