# Скопируйте в .env и подставьте свои значения (файл .env в репозиторий не коммитить).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
USE_SQLITE=True
DB_NAME=cat_breeder
DB_USER=breeder
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Опционально для Docker / продакшена:
# USE_SQLITE=False
# DB_HOST=db
# REDIS_URL=redis://redis:6379/1
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# CSRF_TRUSTED_ORIGINS=http://localhost:4200
